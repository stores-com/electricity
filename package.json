{
    "dependencies": {
        "@babel/core": "~8.0.6",
        "@babel/preset-react": "~8.0.1",
        "chokidar": "~3.6.0",
        "mime": "~3.0.0",
        "negotiator": "~0.6.2",
        "sass": "~1.104.0",
        "snockets": "~1.3.8",
        "uglify-js": "~3.19.3",
        "uglifycss": "~0.0.29"
    },
    "description": "An alternative to the built-in Express middleware for serving static files. Electricity follows a number of best practices for making web pages fast.",
    "devDependencies": {
        "@eslint/js": "*",
        "fs-extra": "*",
        "globals": "*"
    },
    "keywords": [
        "asset",
        "css",
        "express",
        "react",
        "sass",
        "static",
        "snockets"
    ],
    "main": "./lib",
    "license": "MIT",
    "name": "electricity",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stores-com/electricity.git"
    },
    "scripts": {
        "coveralls": "node --test --test-force-exit --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info test/*.js && coveralls < lcov.info",
        "test": "node --test --test-force-exit --test-reporter=spec test/*.js",
        "test:only": "node --test --test-force-exit --test-only --test-reporter=spec test/*.js"
    },
    "version": "4.0.0"
}
